int CDigitalBeamFormer::ms_iNextObjectID = 1;

const char  c_szCalibFile[] = "C:\\EMSDBF_Calib_";


const wchar_t* cwszConnectInfo = L"<Connection><IP>192.54.173.183</IP><Port>9099</Port></Connection>";
