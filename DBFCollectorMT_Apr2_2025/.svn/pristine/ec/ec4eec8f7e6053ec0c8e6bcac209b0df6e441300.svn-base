#ifndef __DATA_PRO_H__
#define __DATA_PRO_H__


#include "emsthread.h"
#include "criticalsection.h"
#include "GSRawBuffer.h"
#include "pointerlist.h"
#include "emsDBF.h"


class CEMSDataProcessor : public CEMSThread
{
	public:
		CEMSDataProcessor();
		CEMSDataProcessor( const CEMSDataProcessor& x );
		virtual ~CEMSDataProcessor();

		void Start();
		void Stop();

		void Reset();

		void LockBuffer( BOOL bWait );

		void UnlockBuffer( );

		bool Initialize();

		bool IsRunning() {return m_bRunning; }

		void GetFreeBuffObjs( CEMSPointerList<CEMSRawBuffObj>& lstObj );
		void AddBuffObj( CEMSRawBuffObj* pObj );

	protected:
		virtual void run();

	private:
		void _ProcessData();
		void _FreeObj( CEMSRawBuffObj* pRawBuff );


	private:
		bool        m_bRunning;
		bool        m_bInitialized;

		FILE*		m_lpLogFile;

		CEMSCriticalSection		m_oCS;
		CEMSCriticalSection		m_oCSIncoming;
		CEMSCriticalSection		m_oCSFreeObjs;

		CEMSPointerList<CEMSRawBuffObj>     m_lstFreeBuffObjs;
		CEMSPointerList<CEMSRawBuffObj>     m_lstUsedBuffObjs;
		CEMSPointerList<CEMSRawBuffObj>     m_lstIncomingBuffObjs;

		CDigitalBeamFormer      m_oDBF;

		static int ms_iSeqNum;

		WORD wProcess;

};

#endif