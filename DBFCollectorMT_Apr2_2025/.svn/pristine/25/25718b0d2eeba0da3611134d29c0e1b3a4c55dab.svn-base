void 
CHGTEigenVectors::_CreateEigenVectors( float* eigenValues, MKL_Complex8 *eigenVectors)
{
	//intel transpose
	//MKL_Complex8 alpha ={1,0};	
	MKL_Complex8 alpha ={1,0};	

	//MKL_Zimatcopy( 'C','T',EIGEN_ROWS, EIGEN_COLS,alpha,m_inputMatrix,EIGEN_ROWS,EIGEN_COLS);
	MKL_Cimatcopy( 'C','T',EIGEN_ROWS, EIGEN_COLS,alpha,m_inputMatrix,EIGEN_ROWS,EIGEN_COLS);

	////intel transpose
	//_CreateTransposed2dMatrix();

	//call zheevd for eigen vectors
	int   info = LAPACKE_cheevd( LAPACK_COL_MAJOR, 'V', 'L', EIGEN_ROWS,m_inputMatrix,  EIGEN_ROWS, eigenValues );
    //int   info = LAPACKE_zheevd( LAPACK_ROW_MAJOR, 'V', 'L', EIGEN_ROWS,m_inputMatrix,  EIGEN_ROWS, (double * ) eigenValues );
    //int   info = LAPACKE_zheevd( LAPACK_COL_MAJOR, 'V', 'U', EIGEN_ROWS,m_inputMatrix,  EIGEN_ROWS, (double * ) eigenValues );

	//memcpy( m_outputEigenValues, eigenValues, sizeof(float) * EIGEN_ROWS );
//********transpose **********/
    memcpy( eigenVectors,m_inputMatrix, EIGEN_ROWS* EIGEN_ROWS  * sizeof(MKL_Complex8) );

	//MKL_Zimatcopy( 'C','T',EIGEN_ROWS, EIGEN_COLS, alpha,eigenVectors,EIGEN_ROWS,EIGEN_COLS);
	//MKL_Cimatcopy( 'C','T',EIGEN_ROWS, EIGEN_ROWS, alpha,eigenVectors,EIGEN_ROWS,EIGEN_COLS);
	//Log values
	//_LogOutputCSV("");
}