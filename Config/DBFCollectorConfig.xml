<?xml version="1.0" encoding="UTF-8"?>
<!--
    DBFCollector runtime configuration.
    Edit this file to change directory paths without recompiling.
    If this file is missing or a tag is absent, the built-in default is used.

    Convention used here:
      Input files/dirs  -> C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Config\
      Output files/dirs -> C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\<subdir>\
-->
<DBFCollectorConfig>
    <Paths>

        <!-- ============================================================ -->
        <!--  Pass/data directories                                        -->
        <!-- ============================================================ -->

        <!-- INPUT: Directory containing DBFPlate_NN.xml plate config files -->
        <ConfigDir>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Config</ConfigDir>

        <!-- OUTPUT: Root directory for pass schedule and output data -->
        <PassDataDir>C:\hgt\DBFPassData\</PassDataDir>

        <!-- OUTPUT: WAV file output when data transmitter send fails -->
        <WavOutputDir>C:\hgt\DBFPassData\WAV\</WavOutputDir>

        <!-- OUTPUT: Eigenvalue bias data output -->
        <BiasEigenDir>C:\hgt\DBFPassData\BiasEigen\</BiasEigenDir>

        <!-- OUTPUT: Signal bias data output -->
        <BiasSignalDir>C:\hgt\DBFPassData\BiasSignal\</BiasSignalDir>

        <!-- OUTPUT: Hourly pass schedule binary files (EMSDBFPass-HH.bin) -->
        <BinOutputDir>C:\hgt\DBFPassData\BIN\</BinOutputDir>

        <!-- OUTPUT: Satellite ID and TOA/FOA binary output -->
        <SatIDDir>C:\hgt\DBFPassData\SatID\</SatIDDir>

        <!-- INPUT: Alternate raw data directory (used by Initialize overload) -->
        <RawAltDir>C:\Raw\</RawAltDir>

        <!-- OUTPUT: Raw ADC capture output directory -->
        <ADCRawDir>D:\ADCraw\</ADCRawDir>

        <!-- ============================================================ -->
        <!--  Calibration                                                  -->
        <!-- ============================================================ -->

        <!-- OUTPUT: Calibration binary file path prefix (appended with _N.bin) -->
        <CalibFilePrefix>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Calibration\EMSDBF_Calib_</CalibFilePrefix>

        <!-- OUTPUT: Directory for per-object calibration trace CSV files -->
        <CalibTraceDir>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Calibration\</CalibTraceDir>

        <!-- ============================================================ -->
        <!--  Covariance / eigenvalue                                      -->
        <!-- ============================================================ -->

        <!-- OUTPUT: Covariance matrix binary output directory -->
        <CovarianceDir>C:\hgt\DBFCovarianceFiles\</CovarianceDir>

        <!-- ============================================================ -->
        <!--  Constellation                                                -->
        <!-- ============================================================ -->

        <!-- INPUT: DBFConstellation XML configuration file -->
        <ConstellationFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Config\DBFConstellation.xml</ConstellationFile>

        <!-- ============================================================ -->
        <!--  Logging                                                      -->
        <!-- ============================================================ -->

        <!-- OUTPUT: Legacy log file path (CTimeElapsed, unused unless LOG_FILE=1) -->
        <LogFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\logfile</LogFile>

        <!-- OUTPUT: Directory for phasecorrn.csv and other debug logs -->
        <LogDir>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\</LogDir>

        <!-- OUTPUT: stdout redirect target used by RedirectToFile() -->
        <LogRedirectFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\logfile</LogRedirectFile>

        <!-- OUTPUT: EMS DBF logger file prefix (appended with _N.txt) -->
        <EMSDBFLogPrefix>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\EMSDBFlogger</EMSDBFLogPrefix>

        <!-- OUTPUT: Timing log file (used when LOG_FILE=1 in TimeElapsed.h) -->
        <TimingLogFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\dbf_timing_log.txt</TimingLogFile>

        <!-- ============================================================ -->
        <!--  Miscellaneous                                                -->
        <!-- ============================================================ -->

        <!-- OUTPUT: Sun azimuth/elevation CSV data file -->
        <SunAzElFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\SunAzEl.csv</SunAzElFile>

        <!-- OUTPUT: Null-satellite test pass CSV output -->
        <NullTestFile>C:\dev\trunk\DBFCollectorMT_VS2026_04_17_26\Logs\NullTest.csv</NullTestFile>

        <!-- Drive letter monitored for free disk space (update if data is on a different drive) -->
        <DataDrive>C:\</DataDrive>

    </Paths>
</DBFCollectorConfig>
