EMS_RESULT
CDigitalBeamFormer::DBFprocessor2( const unsigned long *clpRawTimeSeries, int iNumSats  )
{
	CEMSTime timeStart =  CEMSSystemClock::GetTime();
	EMS_RESULT hr = EMS_BAD_PARAM;
	float fScaleFactor        = (float)ADC_OFFSET;   // Scale factor for real to integer conversion
	float fScaleFactorInverse = 1.0 / fScaleFactor;  // Scale factor for integer to real conversion

	m_ulMaxPowerIndex = 0;
	m_bOutputOK = true;

	memset( &m_LastCalibRecord, 0, sizeof( m_LastCalibRecord ) );
	// Find 1 second mark

	if ( clpRawTimeSeries )
	{
		ULONG ichan, jsample, index;
		ULONG ulMaxPowerIndex = 0;
		ULONG ulOneSecond = 0;
		double dMean   = 0.0;
		double dStdDev = 0.0;
		EMSCOMPLEX cPhaseCorrection;
		double dPower  = 0.0;


		memset( m_afRawInputSamples, 0, DBF_SAMPLE_SIZE*sizeof(float));
		memset( m_afPowerSpectrum, 0, ( DBF_FFT_COMPLEX_SIZE + 1)*sizeof(float));
		for(int i = 0; i < DBF_MAX_SATELLITES; ++i)
		{
			memset( m_acFFTdata[i], 0, sizeof(EMSCOMPLEX) * DBF_FFT_COMPLEX_SIZE );
		}
	
		hr = BufferStatistics( m_asRawTimeSeries );
		

		for ( ichan = 1; ichan < (int)m_ulChannels; ichan++ )
		{
			// Convert integer to float

			memset( m_afTemp1, 0, DBF_FFT_REAL_SIZE*sizeof(float));
			memset( m_afTemp2, 0, DBF_FFT_REAL_SIZE*sizeof(float));
			
			for ( jsample = 0, index = ichan; jsample < m_ulSamplesPerChannel;  jsample++, index += m_ulChannels )
			{
				m_afTemp1[jsample] = (float) m_asRawTimeSeries[index] * fScaleFactorInverse;
			}

			dStdDev = _EMSsMeanStdDev( m_afTemp1, m_ulSamplesPerChannel, &dMean );

			if( dStdDev == 0.00 )
				continue;

			_EMSsbNormalize(m_afTemp1, m_afTemp2, m_ulSamplesPerChannel, dMean, dStdDev);

			emssRealFftNip( m_afTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2, EMS_SPL_FWD );

			//cPhaseCorrection.re = ((float)(m_aPassSchedule.rec[iSatIndex].nPhaseReal[ichan]))/32768.00;
			//cPhaseCorrection.im = ((float)(m_aPassSchedule.rec[iSatIndex].nPhaseImag[ichan]))/32768.00;
			//for( int iSat = 0; iSat < m_ulSatellites; iSat++ )
			for( int iSat = 0; iSat < iNumSats; iSat++ )			
			{
				memcpy( m_acTemp2 ,m_acTemp1, sizeof(EMSCOMPLEX) * (DBF_FFT_COMPLEX_SIZE+1) );
				// RR - correction to match the tracking dish FFT output by reducing the power output by 40 dB
				//      any drop below this will result in the spectrum display showing anomalies due to its handling of negative dB levels
				cPhaseCorrection.re = ((float)(m_aPassSchedule.rec[iSat].nPhaseReal[ichan]))/32768.00/10000.0;
				cPhaseCorrection.im = ((float)(m_aPassSchedule.rec[iSat].nPhaseImag[ichan]))/32768.00/10000.0;
				//cPhaseCorrection.im *= -1.00 ;

				if( abs(cPhaseCorrection.re) + abs(cPhaseCorrection.im) > 0.0 )   
					_EMScbMpy1( cPhaseCorrection, m_acTemp2, DBF_FFT_COMPLEX_SIZE);
			
				_EMScbAdd2( m_acTemp2, m_acFFTdata[iSat], DBF_FFT_COMPLEX_SIZE );	
		
				
			}
			m_aMaintenance.dMean[ichan]   = dMean;
			m_aMaintenance.dStdDev[ichan] = dStdDev;

		}

		//_OutputMaxPowerPhases( );

		//FILE* lpfftFile = fopen("C:\\HGT\\DBFPassData\\FFT_Test\\fft.bin","wb");
		//if( lpfftFile )
		//{
		//	fwrite( (unsigned char*)m_acFFTdata, 1, DBF_FFT_COMPLEX_SIZE * sizeof( EMSCOMPLEX ), lpfftFile );
		//	fclose( lpfftFile );
		//}


		hr = EMS_OK;
	}
	CEMSTime timeEnd =  CEMSSystemClock::GetTime();
	//printf( "\nDBFProcessor2 -> Time elapsed: %f seconds for %i sats, id: %i \n" ,timeStart.SecondsDifferent( timeEnd), iNumSats,  GetCurrentThreadId() );

	return hr;

	///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//	EMS_RESULT hr = EMS_BAD_PARAM;
//	int	nScaleFactor = 16;      // Scale factor for integer dot product
//	float fScaleFactor        = (float)ADC_OFFSET;   // Scale factor for real to integer conversion
//	float fScaleFactorInverse = 1.0 / fScaleFactor;  // Scale factor for integer to real conversion
//
//	if ( clpRawTimeSeries )
//	{
//
//		// Calculate buffer statistics
//		hr = BufferStatistics( m_asRawTimeSeries );
//
//		ULONG i, j, k, n1, n2, m;
//		ULONG ulIndex, ulSample;
//
//		k = 0;
//		n1 = 0;
//		n2 = m_ulChannels;
//
//
//		for ( i = 0; i < m_ulSatellites; i++ )
//		{
//
//			m = 0;
//			k = 0;
//			memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));
//			memset( m_acTemp1, 0, (DBF_FFT_COMPLEX_SIZE+1)*sizeof(EMSCOMPLEX));
//
//			for ( j = 0; j < m_ulSamplesPerChannel/2; j++ )
//			{
//				// real component
///*				m_acTemp1[k].re = (float) emswDotProd( (short*)&clpRawTimeSeries[m],
//									m_aPassSchedule.rec[i].nPhaseReal, (int) m_ulChannels,
//									NSP_FIXED_SCALE, &nScaleFactor );
//				m += m_ulChannels;
//
//				// imaginary component
//				m_acTemp1[k++].im = (float) emswDotProd( (short*)&clpRawTimeSeries[m],
//									m_aPassSchedule.rec[i].nPhaseImag, (int) m_ulChannels,
//									NSP_FIXED_SCALE, &nScaleFactor );*/
//
//				m_acTemp1[k].re = 0.0;
//				m_acTemp1[k].im = 0.0;
//				for( int iChan = 0; iChan < m_ulChannels; iChan++ )
//				{
//					m_acTemp1[k].re += (float)clpRawTimeSeries[m + iChan] * (float)m_aPassSchedule.rec[i].nPhaseReal[iChan] / 65536.0 ;
//					m_acTemp1[k].im += (float)clpRawTimeSeries[m + iChan] * (float)m_aPassSchedule.rec[i].nPhaseImag[iChan] / 65536.0;
//				}
//				//m_acTemp1[k].re
//				k++;
//				m += m_ulChannels;
//			}
//
//
//			if( m_aPassSchedule.rec[i].ulSatID < 250 ) // phase modulated satellites 
//			{
//
//				m_aPassSchedule.rec[i].ulSatID = 261 + i;
//
//				// Frequency shift
//				/*for ( ulSample = 0; ulSample < DBF_FFT_REAL_SIZE/2; ulSample += 2 )
//				{
//					
