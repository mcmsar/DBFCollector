EMS_RESULT
CDigitalBeamFormer::DBFprocessor2Ex(EMSTIME tm)
{
	EMSTIME timeStart, timeFinish;

	timeStart.intTime  = 0;
	timeFinish.intTime = 0;

	INT64   i64ElapsedTime = 0;

	EMS_RESULT hr = EMS_OK;

//	hr = GetPhaseBuffer( );

	timeStart = CEMSSystemClock::GetTime();

	try
	{
		//hr = DBFprocessor2(m_asRawTimeSeries);
		hr = DBFprocessor22(m_asRawTimeSeries);

		EMSTIME tmActual;
		tmActual = _SetActualTime(tm);

		for( int i = 0; i < m_ulSatellites; i++ )
		{
			_OutputWave( tmActual, i );
			//_OutputWave(tm, i );
		}
	}
	catch( ... )
	{
		printf("Unknown exception occurred (%d).\n", m_nCounter);
	}
  
	timeFinish = CEMSSystemClock::GetTime();

	i64ElapsedTime = timeFinish.intTime - timeStart.intTime;


	m_nCounter++;
	m_dElapsedTime += ((double) i64ElapsedTime) * 1e-9; 
	m_dAverageTime = m_dElapsedTime / (double) m_nCounter;

	m_timeFinish = CEMSSystemClock::GetTime();
	i64ElapsedTime = m_timeFinish.intTime - m_timeStart.intTime;
	double dElapsedTime = ((double) i64ElapsedTime) * 1e-9;


/*	printf( "\n 2, %d, AT(sec) = %f, PT = %f, AveT = %f\n",
		m_nCounter, dElapsedTime, m_dElapsedTime, m_dAverageTime );
*/
	if ( m_lpTraceFile )
	{
		fprintf( m_lpTraceFile, "3,%d,%f,%f,%f,%f,%f,%f,%ld\n",
			m_nCounter, dElapsedTime, m_dElapsedTime, m_dAverageTime,
			m_dMeanADC, m_dStdDevADC, m_dMaxPower, m_ulStartPPS );

	}
	return hr;
}

//---------------------------------------------------------------------------

// Performs phase correction and summation for each satellite

EMS_RESULT
CDigitalBeamFormer::DBFprocessor2( const unsigned short *clpRawTimeSeries )
{

	EMS_RESULT hr = EMS_BAD_PARAM;
	int	nScaleFactor = 16;      // Scale factor for integer dot product
	float fScaleFactor        = (float)ADC_OFFSET;   // Scale factor for real to integer conversion
	float fScaleFactorInverse = 1.0 / fScaleFactor;  // Scale factor for integer to real conversion

	if ( clpRawTimeSeries )
	{

		// Calculate buffer statistics
		hr = BufferStatistics( m_asRawTimeSeries );

		ULONG i, j, k, n1, n2, m;
		ULONG ulIndex, ulSample;

		k = 0;
		n1 = 0;
		n2 = m_ulChannels;


		for ( i = 0; i < m_ulSatellites; i++ )
		{

			m = 0;
			k = 0;
			memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));
			memset( m_acTemp1, 0, (DBF_FFT_COMPLEX_SIZE+1)*sizeof(EMSCOMPLEX));

			for ( j = 0; j < m_ulSamplesPerChannel/2; j++ )
			{
				// real component
/*				m_acTemp1[k].re = (float) emswDotProd( (short*)&clpRawTimeSeries[m],
									m_aPassSchedule.rec[i].nPhaseReal, (int) m_ulChannels,
									NSP_FIXED_SCALE, &nScaleFactor );
				m += m_ulChannels;

				// imaginary component
				m_acTemp1[k++].im = (float) emswDotProd( (short*)&clpRawTimeSeries[m],
									m_aPassSchedule.rec[i].nPhaseImag, (int) m_ulChannels,
									NSP_FIXED_SCALE, &nScaleFactor );*/

				m_acTemp1[k].re = 0.0;
				m_acTemp1[k].im = 0.0;
				for( int iChan = 0; iChan < m_ulChannels; iChan++ )
				{
					m_acTemp1[k].re += (float)clpRawTimeSeries[m + iChan] * (float)m_aPassSchedule.rec[i].nPhaseReal[iChan] / 65536.0 ;
					m_acTemp1[k].im += (float)clpRawTimeSeries[m + iChan] * (float)m_aPassSchedule.rec[i].nPhaseImag[iChan] / 65536.0;
				}
				//m_acTemp1[k].re
				k++;
				m += m_ulChannels;
			}


			if( m_aPassSchedule.rec[i].ulSatID < 250 ) // phase modulated satellites 
			{

				m_aPassSchedule.rec[i].ulSatID = 261 + i;

				// Frequency shift
				/*for ( ulSample = 0; ulSample < DBF_SAMPLE_SIZE/2; ulSample += 2 )
				{
					
					m_acTemp1[ulSample].re = -m_acTemp1[ ulSample ].re;
					m_acTemp1[ulSample].im = -m_acTemp1[ ulSample ].im;
				}*/		
				
				// Compute phase
				//emscbPhase(m_acTemp1,m_afTemp2,DBF_SAMPLE_SIZE/2);
				//emssbMpy1(fScaleFactor / c_dPI, m_afTemp2, DBF_SAMPLE_SIZE/2);

				
			//}
			//else
			//{
			
				for ( ulSample = 0; ulSample < DBF_SAMPLE_SIZE/2; ulSample++ )
				{
					m_afTemp1[ ulSample ] = m_acTemp1[ ulSample ].re;
				}

				m_dMeanADC   = emssMean( m_afTemp1, DBF_SAMPLE_SIZE/2 );
				m_dStdDevADC = emssStdDev ( m_afTemp1, DBF_SAMPLE_SIZE/2 );

				emssbNormalize( m_afTemp1, m_afTemp2, DBF_SAMPLE_SIZE/2, m_dMeanADC, (m_dStdDevADC * 3.0) / fScaleFactor );

			}

			
			// Convert to integer
			//emssbFloatToInt(m_afTemp2, &m_asDBFVector[i * DBF_SAMPLE_SIZE/2], DBF_SAMPLE_SIZE/2, 16, NSP_Round);
			ulIndex = i * (DBF_SAMPLE_SIZE/2);
			emssbFloatToInt(m_afTemp2, &m_asDBFVector[ulIndex], DBF_SAMPLE_SIZE/2, 16, NSP_Round);

			n1 += m_ulChannels * 2;
			n2 += m_ulChannels * 2;

		}

		hr = EMS_OK;
	}
	return hr;
}
