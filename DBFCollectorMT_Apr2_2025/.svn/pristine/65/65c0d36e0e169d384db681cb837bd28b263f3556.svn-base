void 
CDigitalBeamFormer::Reset( )
{
	if (m_lpTraceFile)
	{
		fclose( m_lpTraceFile );
		m_lpTraceFile = 0;
	}
	if (m_lpOutputFile)
	{
		fclose( m_lpOutputFile );
		m_lpOutputFile = 0;
	}

	if( m_pDataTransmit )
	{
		m_pDataTransmit->Disconnect();
		m_pDataTransmit->Release();
		m_pDataTransmit = NULL;
	}
}


//---------------------------------------------------------------------------

EMS_RESULT 
CDigitalBeamFormer::BufferStatistics( const unsigned long *m_asRawTimeSeries )
{
	EMS_RESULT hr = EMS_BAD_PARAM;

	if ( (m_asRawTimeSeries) && (m_afPowerSpectrum) )
	{
		memset( m_afTemp1, 0, m_ulSamplesPerChannel*sizeof(float));
		memset( m_afRawInputSamples, 0, m_ulSamplesPerChannel*sizeof(float));

		ULONG ichunk = 0;
		ULONG iSample = 0;

		// Outer loop divides data block into chunks

		for ( ichunk = 0, iSample = 0; ichunk < m_ulChannels*m_ulSamplesPerChannel; ichunk += m_ulChannels )
		{

			// Convert unsigned integer to float
			emssbIntToFloat( &m_asRawTimeSeries[ichunk], m_afRawInputSamples, m_ulChannels, 32, 0x0800);
			m_afTemp1[iSample++] = emssMean( m_afRawInputSamples, m_ulChannels );

		}

		//m_dMeanADC   = emssMean( &m_afTemp1[0], m_ulSamplesPerChannel );
		//m_dStdDevADC = emssStdDev ( &m_afTemp1[0], m_ulSamplesPerChannel );

		m_dStdDevADC = _EMSsMeanStdDev( &m_afTemp1[0], m_ulSamplesPerChannel, &m_dMeanADC);

		_EMSsbNormalize(m_afTemp1, m_afRawInputSamples, m_ulSamplesPerChannel, m_dMeanADC, m_dStdDevADC);

		m_dMaxPower = _EMSsMaxExt( &m_afRawInputSamples[0], m_ulSamplesPerChannel, &m_ulStartPPS );

		m_dMinPower = _EMSsMinExt( &m_afRawInputSamples[0], m_ulSamplesPerChannel, &m_ulStopPPS );



		hr = EMS_OK;

	}
	return hr;
}

float
CDigitalBeamFormer::_EMSsMean(const float *vec, ULONG len)
{
	float fMean = 0.0;
	for( ULONG i = 0; i < len; i++ )
	{
		fMean += vec[i];
	}

	fMean = fMean/(float)len;

	return fMean;
}


double
CDigitalBeamFormer::_EMSsMeanStdDev(const float *vec, ULONG len, double* pfMean )
{
	double fSum = 0.00;
	double fMean = 0.00; 
	double fStdDev = 0.00;

    ULONG i;

    for(i = 0; i < len; ++i)
    {
        fSum += vec[i];
    }

    fMean = fSum/len;
	*pfMean = fMean;

    for(i = 0; i < len; ++i)
        fStdDev += pow(vec[i] - fMean, 2);

    return sqrt(fStdDev / len);
}

float
CDigitalBeamFormer::_EMSsMaxExt(const float  *vec, int len, ULONG* index)
{
	float fMaxVal = -1.0;
	for( ULONG i = 0; i < len; i++ )
	{
		if( fMaxVal < vec[i] )
		{
			fMaxVal = vec[i];
			*index = i;
		}
	}
	return fMaxVal;
}

float
CDigitalBeamFormer::_EMSsMinExt(const float  *vec, int len, ULONG* index)
{
	float fMinVal = vec[0];
	for( ULONG i = 0; i < len; i++ )
	{
		if( fMinVal > vec[i] )
		{
			fMinVal = vec[i];
			*index = i;
		}
	}
	return fMinVal;
}

//---------------------------------------------------------------------------

EMS_RESULT
CDigitalBeamFormer::RemoveTimePulse( float *afRawTimeSeries )
{

	EMS_RESULT hr = EMS_OK;

	if( m_ulStartPPS > 0 && m_ulStopPPS < m_ulSamplesPerChannel - PULSE_SHAPE_SIZE )
	{

		for ( int i = 0; i < PULSE_SHAPE_SIZE; i++ )
		{
			afRawTimeSeries[ i + m_ulStartPPS - 2 ] *= m_afPulseShape[ i ];
			afRawTimeSeries[ i + m_ulStopPPS - 2  ] *= m_afPulseShape[ i ];

		}

	}
	else
		hr = EMS_BAD_PARAM;

	return hr;
}
//---------------------------------------------------------------------------

HRESULT 
CDigitalBeamFormer::_InitDT()
{
	EMS_RESULT hr =  E_FAIL;
	if(!m_pDataTransmit)
	{
		hr = CoCreateInstance( CLSID_DataXmitter, NULL, CLSCTX_ALL,
							   IID_IEMSDataTransmitter, (void**) &m_pDataTransmit );
		//std::wstring cwszConnectInfo = std::wstring(L"<Connection><ip_address>")  + m_wsSPIP + ::wstring(L"</ip_address><port_id>9070</port_id></Connection>");

		if( EMS_OK != hr || m_pDataTransmit == NULL)
		{
			//printf("\n Failed to load Data Transmitter");
		}
		else if( EMS_OK != m_pDataTransmit->Connect( m_wsSPIP.c_str() ) )
		{
			m_pDataTransmit->Release();
			m_pDataTransmit = NULL;
			//printf("\n Data Transmitter failed to connect");
		}
		else
		{
			//printf("\n Connected");
		}
	}
	return hr;
}

//---------------------------------------------------------------------------

EMS_RESULT
CDigitalBeamFormer::DBFprocessor1Ex(EMSTIME tm)
{
	EMSTIME timeStart, timeFinish;

	timeStart.intTime  = 0;
	timeFinish.intTime = 0;

	INT64   i64ElapsedTime = 0;

	EMS_RESULT hr = EMS_OK;

	timeStart = CEMSSystemClock::GetTime();

	try
	{
		if( m_ulSatellites > 0 )
			hr = DBFprocessor1(m_asRawTimeSeries);

		//EMSTIME tmActualTime = _SetActualTime(tm);
		//_OutputWave( m_timeActual, 0 );
		_OutputWaveExProcess1(  m_timeActual, 1 );

//		_OutputCalibData( m_timeActual );

	}
	catch( ... )
	{
		//printf("Unknown exception occurred (%d).\n", m_nCounter);
	}
  
	timeFinish = CEMSSystemClock::GetTime();

	i64ElapsedTime = timeFinish.intTime - timeStart.intTime;


	m_nCounter++;
	m_dElapsedTime += ((double) i64ElapsedTime) * 1e-9; 
	m_dAverageTime = m_dElapsedTime / (double) m_nCounter;

	m_timeFinish = CEMSSystemClock::GetTime();
	i64ElapsedTime = m_timeFinish.intTime - m_timeStart.intTime;
	double dElapsedTime = ((double) i64ElapsedTime) * 1e-9;


/*	printf( "\n 1, %d, AT(sec) = %f, PT = %f, AveT = %f\n",
		m_nCounter, dElapsedTime, m_dElapsedTime, m_dAverageTime );
*/
	if ( m_lpTraceFile )
	{
		fprintf( m_lpTraceFile, "1, %d, %I64d, %f,%f,%f, %f,%f,%f,%ld,%ld, %ld\n",
			m_nCounter, tm.intTime, dElapsedTime, m_dElapsedTime, m_dAverageTime,
			m_dMeanADC, m_dStdDevADC, m_dMaxPower, m_ulStartPPS, m_ulStopPPS - m_ulStartPPS,
			m_ulMaxPowerIndex);

	}
	return hr;
}

EMSTIME 
CDigitalBeamFormer::_SetActualTime( EMSTIME tm )
{
	return m_timeActual;
	EMSTIMEFIELDS tmFlds;
	CEMSTime oTM(tm);

	oTM.GetTime(&tmFlds);

	CEMSTime oActualTime;
	oActualTime.SetTime(tmFlds.nYear, tmFlds.nMonth, tmFlds.nDay, tmFlds.nHour, tmFlds.nMinute, tmFlds.nSecond, 0 );

	m_ulMarkerBitRate = 500000;  //TBD

	if( m_ulLastStartPPS > 0 && !m_oLastPPS.IsZero() )
	{
//		double dSecondDiff = m_oLastPPS.SecondsDifferent(oActualTime);
		double dSecondDiff = m_oLastPPS.SecondsDifferent(tm);
		if( dSecondDiff < 0.0 )
		{
			dSecondDiff *= -1.0;
		}
		dSecondDiff *= 2;
		dSecondDiff = ((ULONG)dSecondDiff) / 2.0;

		//m_ulMarkerBitRate += (m_ulLastStartPPS - m_ulStartPPS) / dSecondDiff;
	}

	//double dTimeFraction = (double) m_ulStartPPS / (double) m_ulMarkerBitRate;

	double dTimeFraction = (double) (m_ulStartPPS) / (double) m_ulMarkerBitRate;

//	m_oLastPPS = oActualTime;
	m_oLastPPS = tm;
	m_ulLastStartPPS = m_ulStartPPS;

	// To find start time of buffer subtract time fraction
	oActualTime.AddSeconds(-dTimeFraction);

	double dSecDiff = oTM.SecondsDifferent(oActualTime);

	if( dSecDiff < -1.001 )
	{
		oActualTime.AddSeconds(1.0);
	}
	else if( dSecDiff > 1.001 )
	{
		oActualTime.AddSeconds(-1.0);
	}

	// 0.5 second offset correction
	oActualTime.AddSeconds(-0.5);

	return oActualTime;
}



int
CDigitalBeamFormer::_GetMostCommonIndex( ULONG* arr, int iCount)
{
	int iRet = -1;
	ULONG arrCount[32];
	memset( arrCount, 0, sizeof( arrCount ) );

	for( int i = 0; i < 32; i++ )
	{
		for( int j = i + 1; j < 32; j++)
		{
			if( arr[i] == arr[j] )
				arrCount[i]++;
		}
	}

	ULONG lTest = 0;
	for( int k = 0; k < 32; k++ )
	{
		if( lTest < arrCount[k] )
		{
			lTest = arrCount[k];
			iRet = k;
		}
	}

	return iRet;
}


void
CDigitalBeamFormer::_EMScbPowerSpectr(const EMSCOMPLEX *src, float *spectr,ULONG length)
{
	if( src && spectr )
	{
		for( ULONG i = 0; i < length; i++ )
		{
			spectr[i] = sqrt( src[i].re * src[i].re + src[i].im * src[i].im );
		}
	}
}

void
CDigitalBeamFormer::_EMSsbNormalize( const float *src, float *dst, ULONG n, const float valuesub, const float valuediv )
{
	if( src && dst )
	{
		for( ULONG i = 0; i < n; i++ )
		{
			dst[i] = ( src[i] -  valuesub ) / valuediv;
		}
	}
}


void
CDigitalBeamFormer::_EMScbMpy1( const EMSCOMPLEX val, EMSCOMPLEX *dst, ULONG n )
{
	if( dst )
	{
		EMSCOMPLEX cTemp;
		
		for( ULONG i = 0; i < n; i++ )
		{
			//as suggested by Sichun, changing the code for .re
			//cTemp.re = dst[i].re * val.re + dst[i].im * val.im;
			cTemp.re = dst[i].re * val.re - dst[i].im * val.im;
			cTemp.im = dst[i].re * val.im + dst[i].im * val.re;
			dst[i].re = cTemp.re;
			dst[i].im = cTemp.im;
		}
	}
}

void
CDigitalBeamFormer::_EMScbAdd2( const EMSCOMPLEX *src, EMSCOMPLEX *dst, ULONG n )
{
	if( src && dst )
	{
		for( ULONG i = 0; i < n; i++ )
		{
			dst[i].re += src[i].re;
			dst[i].im += src[i].im;
		}
	}
}

void
CDigitalBeamFormer::_EMSsbMpy1( const float val, float *dst, ULONG n )
{
	if( dst )
	{
		for( ULONG i = 0; i < n; i++ )
		{
			dst[i] *= val;
		}
	}
}

//---------------------------------------------------------------------------

// Performs FFT on each channel and phase corrects using frequency of maximum carrier power

EMS_RESULT
CDigitalBeamFormer::DBFprocessor1( const unsigned long *clpRawTimeSeries )
{

	EMS_RESULT hr = EMS_BAD_PARAM;
	float fScaleFactor        = (float)ADC_OFFSET;   // Scale factor for real to integer conversion
	float fScaleFactorInverse = 1.0 / fScaleFactor;  // Scale factor for integer to real conversion
	m_ulMaxPowerIndex = 0;

	m_bOutputOK = true;

	memset( &m_LastCalibRecord, 0, sizeof( m_LastCalibRecord ) );
	// Find 1 second mark

	if ( clpRawTimeSeries )
	{
		ULONG ichan, jsample, index;
		ULONG ulMaxPowerIndex = 0;
		ULONG ulOneSecond = 0;
		double dMean   = 0.0;
		double dStdDev = 0.0;
		EMSCOMPLEX cPhaseCorrection;
		double dPower  = 0.0;

		memset( m_afRawInputSamples, 0, DBF_SAMPLE_SIZE*sizeof(float));
		memset( m_afPowerSpectrum, 0, ( DBF_FFT_COMPLEX_SIZE + 1)*sizeof(float));
//		memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));
	
//		hr = BufferStatistics( m_asRawTimeSeries );
		
		memset( m_afTemp1, 0, DBF_FFT_REAL_SIZE*sizeof(float));
		memset( m_afTemp2, 0, DBF_FFT_REAL_SIZE*sizeof(float));
		//memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));

//		int iGoodChan[25] = {1,2,4,5,6,7,9,10,12,13,14,22,23,27,34,37,39,40,42,43,45,49,51,59,64};
		ULONG aulMostConsistentIndex[32];
		memset( aulMostConsistentIndex, 0, sizeof(aulMostConsistentIndex) );

		for ( ichan = 1; ichan < (int)m_ulChannels; ichan++ )
		{
			// Convert integer to float
			memset( m_afTemp1, 0, DBF_FFT_REAL_SIZE*sizeof(float));
			memset( m_afTemp2, 0, DBF_FFT_REAL_SIZE*sizeof(float));

			for ( jsample = 0, index = ichan; jsample < m_ulSamplesPerChannel;  jsample++, index += m_ulChannels )//m_ulSamplesPerChannel = 1000000
			{
				m_afTemp1[jsample] = (float) m_asRawTimeSeries[index] * fScaleFactorInverse;
			}

			//dMean   = emssMean( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );
			//dStdDev = emssStdDev ( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );

			dStdDev = _EMSsMeanStdDev( m_afTemp1, m_ulSamplesPerChannel, &dMean );

			if( dStdDev == 0.00 )
				continue;

			_EMSsbNormalize(m_afTemp1, m_afTemp2, m_ulSamplesPerChannel, dMean, dStdDev);

			emssRealFftNip( m_afTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2, EMS_SPL_FWD );

//			emscbPowerSpectr(m_acTemp1, m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE);
			_EMScbPowerSpectr( m_acTemp1, m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE/2 );

			//m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[10], DBF_FFT_COMPLEX_SIZE-11, (int *)&m_ulMaxPowerIndex );
			//m_ulMaxPowerIndex += (10);

			m_dMaxPower = 0;
			for( ULONG k = 10000; k < DBF_FFT_COMPLEX_SIZE/2-10001; k++ )
			{
				if( m_dMaxPower < m_afPowerSpectrum[k] )
				{
					m_dMaxPower = m_afPowerSpectrum[k];
					m_ulMaxPowerIndex = k;
				}
			}

			

			aulMostConsistentIndex[ichan] = m_ulMaxPowerIndex;

			_EMScbAdd2( m_acTemp1, m_acFFTdata[0], DBF_FFT_COMPLEX_SIZE );	
		
		}

		int iBestIndex = _GetMostCommonIndex( (ULONG*) aulMostConsistentIndex, 32 );
		iBestIndex=0;
		if( iBestIndex > 0 )
		{
			m_ulMaxPowerIndex = aulMostConsistentIndex[iBestIndex];
		}
		else
		{
			_EMScbPowerSpectr(m_acFFTdata[0], m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE/2);
			//emscbPowerSpectr(m_acFFTdata, m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE);

			//m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[10], DBF_FFT_COMPLEX_SIZE-11, (int *)&m_ulMaxPowerIndex );
			//m_ulMaxPowerIndex += (10);
			m_dMaxPower = 0;
			for( ULONG k = 10000; k < DBF_FFT_COMPLEX_SIZE/2-10001; k++ )
			{
				if( m_dMaxPower < m_afPowerSpectrum[k] )
				{
					m_dMaxPower = m_afPowerSpectrum[k];
					m_ulMaxPowerIndex = k;
				}
			}
		}

		//memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));

		m_emsDBFBufferPhase.ulMaxFreqIndex = m_ulMaxPowerIndex;
		m_emsDBFBufferPhase.dMaxPowerlevel = m_dMaxPower;
		for ( ichan = 1; ichan < (int)m_ulChannels; ichan++ )
		{
			// Convert integer to float

			memset( m_afTemp1, 0, DBF_FFT_REAL_SIZE*sizeof(float));
			memset( m_afTemp2, 0, DBF_FFT_REAL_SIZE*sizeof(float));
			
			//rr  for ( jsample = 0, index = ichan; jsample < m_ulSamplesPerChannel;  jsample++, index += m_ulChannels )
			for ( jsample = 1, index = ichan; jsample < m_ulSamplesPerChannel;  jsample++, index += m_ulChannels )
			{
				m_afTemp1[jsample] = (float) m_asRawTimeSeries[index] * fScaleFactorInverse;
			}

			/*
			//looking the good channels only here
			bool bOK = false;

			for( int iGood = 0; iGood < 25 && !bOK; iGood++ )
			{
				if( ichan == (iGoodChan[iGood] - 1) )
					bOK = true;
			}
			if( !bOK )
				continue;

			*/
//			hr = RemoveTimePulse( m_afTemp1 );

			//dMean   = emssMean( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );
			//dStdDev = emssStdDev ( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );

			dStdDev = _EMSsMeanStdDev( m_afTemp1, m_ulSamplesPerChannel, &dMean );

			if( dStdDev == 0.00 )
				continue;

//			emssbNormalize(m_afTemp1, m_afTemp2, m_ulSamplesPerChannel, dMean, dStdDev);
			
			_EMSsbNormalize(m_afTemp1, m_afTemp2, m_ulSamplesPerChannel, dMean, dStdDev);

			emssRealFftNip( m_afTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2, EMS_SPL_FWD );


			//if ( ichan == 0 )
			//{
			//	emscbPowerSpectr(m_acTemp1, m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE);

			//	m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[DBF_FFT_COMPLEX_SIZE/4], DBF_FFT_COMPLEX_SIZE/2, (int *)&m_ulMaxPowerIndex );
			//	m_ulMaxPowerIndex += (DBF_FFT_COMPLEX_SIZE/4);
			//}

			// Phase correct

			//m_ulMaxPowerIndex = 261904; // for debugging and fixing the satellite id in view

			dPower  = m_acTemp1[m_ulMaxPowerIndex].re * m_acTemp1[m_ulMaxPowerIndex].re;
			dPower += m_acTemp1[m_ulMaxPowerIndex].im * m_acTemp1[m_ulMaxPowerIndex].im;
			//dPower  = sqrt( dPower ) * (double)m_ulChannels;
			dPower  = sqrt( dPower );



			cPhaseCorrection.re =  m_acTemp1[m_ulMaxPowerIndex].re / (float)dPower;
			cPhaseCorrection.im = -1.0 * m_acTemp1[m_ulMaxPowerIndex].im / (float)dPower;

			
			m_LastCalibRecord.fCalibPhaseReal[ichan] = (short)(cPhaseCorrection.re * fScaleFactor);
			m_LastCalibRecord.fCalibPhaseImag[ichan] = (short)(cPhaseCorrection.im * fScaleFactor);

			m_emsDBFBufferPhase.fPhase[ichan] = atan2( cPhaseCorrection.im, cPhaseCorrection.re );

			cPhaseCorrection.re = ((float)(m_aPassSchedule.rec[0].nPhaseReal[ichan]))/32768.00;
			cPhaseCorrection.im = ((float)(m_aPassSchedule.rec[0].nPhaseImag[ichan]))/32768.00;

			m_emsDBFBufferPhase.fBias[ichan] = atan2( cPhaseCorrection.im, cPhaseCorrection.re );
			m_emsDBFBufferPhase.fBias[ichan]  -= m_emsDBFBufferPhase.fPhase[ichan];

//			m_LastCalibRecord.fCalibPhaseReal[ichan] = m_acTemp1[m_ulMaxPowerIndex].re;
//			m_LastCalibRecord.fCalibPhaseImag[ichan] = m_acTemp1[m_ulMaxPowerIndex].im;


			//m_asPhaseVector[ichan * 2 ]    = (short) ( cPhaseCorrection.re * fScaleFactor );
			//m_asPhaseVector[ichan * 2 + 1] = (short) ( cPhaseCorrection.im * fScaleFactor );

			// Accumulate FFT data from each channel
			//emscbMpy1( cPhaseCorrection, m_acTemp1, DBF_FFT_COMPLEX_SIZE);
			
			//test no phase correction.
			_EMScbMpy1( cPhaseCorrection, m_acTemp1, DBF_FFT_COMPLEX_SIZE/2);

			//emscbAdd2( m_acTemp1, m_acFFTdata, DBF_FFT_COMPLEX_SIZE );	
			_EMScbAdd2( m_acTemp1, m_acFFTdata[0], DBF_FFT_COMPLEX_SIZE/2 );	
		
			m_aMaintenance.dMean[ichan]   = dMean;
			m_aMaintenance.dStdDev[ichan] = dStdDev;

		}

		//int iCount = 0;
		//float fPower1 = 0.0;
		//float fPower2 = 0.0;

		//for( ULONG k = 0; k < DBF_FFT_COMPLEX_SIZE-1; k++ )
		//{
		//	fPower1  = m_acFFTdata[k].re * m_acFFTdata[k].re;
		//	fPower1 += m_acFFTdata[k].im * m_acFFTdata[k].im;
		//	fPower1  = sqrt( fPower1 );

		//	if( fPower1 == 0.00 )
		//		continue;
		//	fPower2  = m_acFFTdata[k+1].re * m_acFFTdata[k+1].re;
		//	fPower2 += m_acFFTdata[k+1].im * m_acFFTdata[k+1].im;
		//	fPower2  = sqrt( fPower2 );

		//	if( (fPower2/fPower1) > 10.00 )
		//		iCount++;
		//}
		//
		//if( iCount > 1000 )
		//	m_bOutputOK = false;
		//else
		//	int x = 1;

		//for( ULONG k = 0; k < DBF_FFT_COMPLEX_SIZE; k++ )
		//{
		//	m_acFFTdata[k].im *= -1.0;
		//}
		// Perform spectrum inversion
		//KA comment out
		//for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index++ )
		//{

		//	m_acTemp2[ index ].re =  m_acFFTdata[ DBF_FFT_COMPLEX_SIZE - index -1 ].re; 
		//	m_acTemp2[ index ].im = -m_acFFTdata[ DBF_FFT_COMPLEX_SIZE - index -1 ].im; 

		//}

		// Convert to Time Domain
//		emscFftNip( m_acTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2-1, EMS_SPL_INV );
//		emscFftNip( m_acTemp2, m_acFFTdata, DBF_FFT_SIZE_LOG2-1, EMS_SPL_INV );

//		emssRealFftNip( m_afTemp2, m_acFFTdata, DBF_FFT_SIZE_LOG2, EMS_SPL_INV );

		// Frequency shift
		//KA comment out
		//for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index+=2 )
		//{
		//	
		//	m_acTemp1[index].re = -m_acTemp1[ index ].re;
		//	m_acTemp1[index].im = -m_acTemp1[ index ].im;
		//}		
		//
		
		// Compute phase
//		emscbPhase(m_acTemp1,m_afTemp1,DBF_FFT_COMPLEX_SIZE);

//		emssbMpy1(fScaleFactor / c_dPI, m_afTemp1, DBF_FFT_COMPLEX_SIZE);
//		emssbMpy1( (fScaleFactor/8), m_afTemp2, DBF_FFT_REAL_SIZE);

		//int iMaxValue = 0;
		//float ddMaxValue = emssMaxExt( &m_afTemp2[0], DBF_SAMPLE_SIZE, &iMaxValue );
		//float ddMinValue = emssMinExt( &m_afTemp2[0], DBF_SAMPLE_SIZE, &iMaxValue );
		////emssMaxExt( m_afTemp2, , (int *)&m_ulMaxPowerIndex );


		//float fScale = 0.0;
		//if( ddMaxValue != 0.00 || ddMinValue != 0.00) 
		//{
		//	if( abs(ddMaxValue) > abs(ddMinValue) )
		//	{
		//		fScale = 32000.00/ abs(ddMaxValue);
		//	}
		//	else
		//		fScale = 32000.00/abs(ddMinValue);
		//}

		//emssbMpy1( fScale, m_afTemp2, DBF_FFT_REAL_SIZE);
//		_EMSsbMpy1( fScale, m_afTemp2, DBF_FFT_REAL_SIZE);


		// Convert to integer
//		emssbFloatToInt(m_afTemp1, m_asDBFVector, DBF_SAMPLE_SIZE/2, 16, NSP_Round);
//		emssbFloatToInt(m_afTemp1, m_asDBFVector, DBF_SAMPLE_SIZE, 16, NSP_Round);

		//		emssbFloatToInt(m_afTemp2, m_asDBFVector, DBF_SAMPLE_SIZE, 16, NSP_Round);


		hr = EMS_OK;
	}
	return hr;
}

void 
CDigitalBeamFormer::_IsTimeToCopyCovarFile( const EMSTIME& oCurrentTime)
{
		//check if covariance file send time is up

		CEMSTime oNext(m_oDBFCovarFileLastWriteTime);
		oNext.AddHours(TIMETO_SEND_COVARIANCE_FILE);
		//oNext.AddHours(0.2);
		
		EMSTIME tmNext = oNext;
		EMSTIME tmCurrent = oCurrentTime;

		if( tmCurrent.intTime >= tmNext.intTime )
		{
			m_bIsCovarFileSendTime = TRUE;
			m_oDBFCovarFileLastWriteTime = oCurrentTime;
		}
		/*else
			m_bIsCovarFileSendTime = FALSE;*/
		//check if covariance file send time is up
		
	
}
bool 
CDigitalBeamFormer::_IsTimeToCopyBufferPhaseFile( const EMSTIME& oCurrentTime)
{
	bool bRet = false;
	if( 0 == m_oDBFBufferPhaseLastWriteTime.GetTimeNano() )
	{
		m_oDBFBufferPhaseLastWriteTime =  m_oDBFCovarFileLastWriteTime = CEMSSystemClock::GetTime();
		bRet = true;
	}
	else
	{
		// check one hour.
		CEMSTime oNext(m_oDBFBufferPhaseLastWriteTime);
		oNext.AddHours(1.0);
		//oNext.AddHours(0.2);
		
		EMSTIME tmNext = oNext;
		EMSTIME tmCurrent = oCurrentTime;

		if( tmCurrent.intTime >= tmNext.intTime )
		{
			bRet = true;
		}
		_IsTimeToCopyCovarFile( oCurrentTime );
	}
	return bRet;
}




EMS_RESULT
CDigitalBeamFormer::DBFprocessor22( const unsigned long *clpRawTimeSeries )
{

	EMS_RESULT hr = EMS_BAD_PARAM;
	float fScaleFactor        = (float)ADC_OFFSET;   // Scale factor for real to integer conversion
	float fScaleFactorInverse = 1.0 / fScaleFactor;  // Scale factor for integer to real conversion

	memset( &m_LastCalibRecord, 0, sizeof( m_LastCalibRecord ) );
	// Find 1 second mark

	if ( clpRawTimeSeries )
	{
		ULONG ichan, jsample, index;
		ULONG ulMaxPowerIndex = 0;
		ULONG ulMaxPowerIndex1 = 0;
		ULONG ulOneSecond = 0;
		double dMean   = 0.0;
		double dStdDev = 0.0;
		EMSCOMPLEX cPhaseCorrection;
		EMSCOMPLEX cPhaseCorrection1;
		double dPower  = 0.0;

		memset( m_afRawInputSamples, 0, DBF_SAMPLE_SIZE*sizeof(float));
		memset( m_afPowerSpectrum, 0, ( DBF_FFT_COMPLEX_SIZE + 1)*sizeof(float));
		//memset( m_acFFTdata, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));
		//memset( m_acFFTdata1, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));
	
		hr = BufferStatistics( m_asRawTimeSeries );
		
		memset( m_afTemp1, 0, DBF_FFT_REAL_SIZE*sizeof(float));
		memset( m_afTemp2, 0, DBF_FFT_REAL_SIZE*sizeof(float));
		memset( m_acFFTdata, 0, DBF_MAX_SATELLITES*DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));

		memset( m_acFFTdata1, 0, DBF_FFT_COMPLEX_SIZE*sizeof(EMSCOMPLEX));

		for ( ichan = 0; ichan < (int)m_ulChannels; ichan++ )
		{
			// Convert integer to float

			for ( jsample = 0, index = ichan; jsample < m_ulSamplesPerChannel;  jsample++, index += m_ulChannels )
			{
				m_afTemp1[jsample] = (float) m_asRawTimeSeries[index] * fScaleFactorInverse;
			}

//			hr = RemoveTimePulse( m_afTemp1 );

			dMean   = emssMean( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );
			dStdDev = emssStdDev ( &m_afTemp1[0], m_ulSamplesPerChannel / 8 );

			emssbNormalize(m_afTemp1, m_afTemp2, m_ulSamplesPerChannel, dMean, dStdDev);

			emssRealFftNip( m_afTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2, EMS_SPL_FWD );

			memcpy( m_acTemp2, m_acTemp1, (DBF_FFT_COMPLEX_SIZE+1) * sizeof(EMSCOMPLEX) );

			if ( ichan == 0 )
			{
				emscbPowerSpectr(m_acTemp1, m_afPowerSpectrum, DBF_FFT_COMPLEX_SIZE);

				ULONG ulI1 = 261450;
				ULONG ulI2 = 261900;

				//m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[ulI1-200], 400, (int *)&m_ulMaxPowerIndex );
				//m_ulMaxPowerIndex += ulI1;
				m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[DBF_FFT_COMPLEX_SIZE/4], DBF_FFT_COMPLEX_SIZE/2, (int *)&m_ulMaxPowerIndex1 );
				m_ulMaxPowerIndex1 += (DBF_FFT_COMPLEX_SIZE/4);

				memset(&m_afPowerSpectrum[m_ulMaxPowerIndex1-100], 0, 200 * sizeof( float ) );
				
				m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[DBF_FFT_COMPLEX_SIZE/4], DBF_FFT_COMPLEX_SIZE/2, (int *)&m_ulMaxPowerIndex );
				m_ulMaxPowerIndex += (DBF_FFT_COMPLEX_SIZE/4);

				//m_dMaxPower = emssMaxExt( &m_afPowerSpectrum[ulI2-200], 400, (int *)&m_ulMaxPowerIndex1 );
				//m_ulMaxPowerIndex1 += ulI2;

			}

			// Phase correct

			//m_ulMaxPowerIndex = 261904; // for debugging and fixing the satellite id in view

			dPower  = m_acTemp1[m_ulMaxPowerIndex].re * m_acTemp1[m_ulMaxPowerIndex].re;
			dPower += m_acTemp1[m_ulMaxPowerIndex].im * m_acTemp1[m_ulMaxPowerIndex].im;
			//dPower  = sqrt( dPower ) * (double)m_ulChannels;
			dPower  = sqrt( dPower );

			cPhaseCorrection.re =  m_acTemp1[m_ulMaxPowerIndex].re / (float)dPower;
			cPhaseCorrection.im = -m_acTemp1[m_ulMaxPowerIndex].im / (float)dPower;

			// Accumulate FFT data from each channel
			emscbMpy1( cPhaseCorrection, m_acTemp1, DBF_FFT_COMPLEX_SIZE);
			emscbAdd2( m_acTemp1, m_acFFTdata[0], DBF_FFT_COMPLEX_SIZE );	

			/////////////////////////////////////////////////////////////////////////////////////
			dPower  = m_acTemp2[m_ulMaxPowerIndex1].re * m_acTemp2[m_ulMaxPowerIndex1].re;
			dPower += m_acTemp2[m_ulMaxPowerIndex1].im * m_acTemp2[m_ulMaxPowerIndex1].im;
			//dPower  = sqrt( dPower ) * (double)m_ulChannels;
			dPower  = sqrt( dPower );

			cPhaseCorrection1.re =  m_acTemp2[m_ulMaxPowerIndex1].re / (float)dPower;
			cPhaseCorrection1.im = -m_acTemp2[m_ulMaxPowerIndex1].im / (float)dPower;

			// Accumulate FFT data from each channel
			emscbMpy1( cPhaseCorrection1, m_acTemp2, DBF_FFT_COMPLEX_SIZE);
			emscbAdd2( m_acTemp2, m_acFFTdata1, DBF_FFT_COMPLEX_SIZE );	
		

			
			
			//m_aMaintenance.dMean[ichan]   = dMean;
			//m_aMaintenance.dStdDev[ichan] = dStdDev;

		}

		// Perform spectrum inversion
		for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index++ )
		{

			m_acTemp2[ index ].re =  m_acFFTdata[0][ DBF_FFT_COMPLEX_SIZE - index -1 ].re; 
			m_acTemp2[ index ].im = -m_acFFTdata[0][ DBF_FFT_COMPLEX_SIZE - index -1 ].im; 

		}

		// Convert to Time Domain
		emscFftNip( m_acTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2-1, EMS_SPL_INV );

		// Frequency shift

		for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index+=2 )
		{
			
			m_acTemp1[index].re = -m_acTemp1[ index ].re;
			m_acTemp1[index].im = -m_acTemp1[ index ].im;
		}		
		
		
		// Compute phase
		emscbPhase(m_acTemp1,m_afTemp1,DBF_FFT_COMPLEX_SIZE);

		emssbMpy1(fScaleFactor / c_dPI, m_afTemp1, DBF_FFT_COMPLEX_SIZE);

		// Convert to integer
		emssbFloatToInt(m_afTemp1, m_asDBFVector, DBF_FFT_REAL_SIZE/2, 16, NSP_Round);

//////////
				// Perform spectrum inversion
		for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index++ )
		{

			m_acTemp2[ index ].re =  m_acFFTdata1[ DBF_FFT_COMPLEX_SIZE - index -1 ].re; 
			m_acTemp2[ index ].im = -m_acFFTdata1[ DBF_FFT_COMPLEX_SIZE - index -1 ].im; 

		}

		// Convert to Time Domain
		emscFftNip( m_acTemp2, m_acTemp1, DBF_FFT_SIZE_LOG2-1, EMS_SPL_INV );

		// Frequency shift

		for ( index = 0; index < DBF_FFT_COMPLEX_SIZE; index+=2 )
		{
			
			m_acTemp1[index].re = -m_acTemp1[ index ].re;
			m_acTemp1[index].im = -m_acTemp1[ index ].im;
		}		
		
		
		// Compute phase
		emscbPhase(m_acTemp1,m_afTemp1,DBF_FFT_COMPLEX_SIZE);

		emssbMpy1(fScaleFactor / c_dPI, m_afTemp1, DBF_FFT_COMPLEX_SIZE);

		// Convert to integer
		emssbFloatToInt(m_afTemp1, &m_asDBFVector[DBF_FFT_REAL_SIZE/2], DBF_FFT_REAL_SIZE/2, 16, NSP_Round);


		hr = EMS_OK;
	}
	return hr;
}
//---------------------------------------------------------------------------

EMS_RESULT
CDigitalBeamFormer::DBFprocessor2Ex(EMSTIME tm)
{
	EMSTIME timeStart, timeFinish;

	timeStart.intTime  = 0;
	timeFinish.intTime = 0;

	int iSatMax = 0;
	ULONG ulSatMaxFreq = 0;
	double dSatMaxPower = 0;
	double dPeakPhase[DBF_MAX_CHANNELS];

	double dPowerThreshold = 35.00;

	INT64   i64ElapsedTime = 0;

	EMS_RESULT hr = EMS_OK;

//	hr = GetPhaseBuffer( );
	//printf("\n DBFprocessor2Ex" ); 

	timeStart = CEMSSystemClock::GetTime();

	try
	{
		int iMax = m_ulSatellites;
		//if( m_ulSatellites >=1 )
		if( m_ulSatellites >= DBF_MAX_SATELLITES )
		//if( m_ulSatellites >= 2 )
		{
			//iMax = 2;
			iMax = DBF_MAX_SATELLITES;
		}
		else
			iMax = m_ulSatellites;
			
//			memset( &m_emsDBFBufferPhase, 0, sizeof(m_emsDBFBufferPhase) );
		//setting the last value of the rawtimeseries to 0 as per Rich
		m_asRawTimeSeries[DBF_SAMPLE_SIZE * DBF_MAX_CHANNELS -1] = 0;
		hr = DBFprocessor2(m_asRawTimeSeries, iMax );
		_OutputWaveEx( m_timeActual, iMax );
		_OutputMaxPowerPhases(iMax );
		//printf(  "\nProcess2 %I64d, Sats %ld\n", m_timeActual.intTime, m_ulSatellites );

	}

	catch( ... )
	{
		//printf("Unknown exception occurred (%d).\n", m_nCounter);
	}
  
	timeFinish = CEMSSystemClock::GetTime();

	i64ElapsedTime = timeFinish.intTime - timeStart.intTime;


	m_nCounter++;
	m_dElapsedTime += ((double) i64ElapsedTime) * 1e-9; 
	m_dAverageTime = m_dElapsedTime / (double) m_nCounter;

	m_timeFinish = CEMSSystemClock::GetTime();
	i64ElapsedTime = m_timeFinish.intTime - m_timeStart.intTime;
	double dElapsedTime = ((double) i64ElapsedTime) * 1e-9;


/*	printf( "\n 2, %d, AT(sec) = %f, PT = %f, AveT = %f\n",
		m_nCounter, dElapsedTime, m_dElapsedTime, m_dAverageTime );
*/
	if ( m_lpTraceFile )
	{
		fprintf( m_lpTraceFile, "3,%d,%f,%f,%f,%f,%f,%f,%ld\n",
			m_nCounter, dElapsedTime, m_dElapsedTime, m_dAverageTime,
			m_dMeanADC, m_dStdDevADC, m_dMaxPower, m_ulStartPPS );

	}
	return hr;
}

